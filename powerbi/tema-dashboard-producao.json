{
  "name": "Dashboard Producao",
  "dataColors": [
    "#2bb7a8",
    "#56c77d",
    "#f3c766",
    "#e65f6f",
    "#73a7ff",
    "#b9f1e8"
  ],
  "background": "#0b0a0f",
  "foreground": "#f4f2f2",
  "tableAccent": "#2bb7a8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": "#f4f2f2",
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": "#f4f2f2",
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": "#f4f2f2",
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": "#f4f2f2",
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": "#f4f2f2",
            "background": "#1b1b22",
            "outline": "Frame"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": "#f4f2f2",
            "background": "#1b1b22"
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": "#13746f"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": "#f4f2f2",
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "dataLabels": [
          {
            "show": true,
            "color": "#f4f2f2",
            "fontSize": 9,
            "displayUnits": 1000,
            "labelDisplayUnits": "Thousands"
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "dataPoint": [
          {
            "fill": "#56c77d"
          }
        ],
        "labels": [
          {
            "color": "#f4f2f2",
            "fontSize": 26
          }
        ],
        "calloutValue": [
          {
            "color": "#f4f2f2",
            "fontSize": 28
          }
        ]
      }
    }
  }
}
